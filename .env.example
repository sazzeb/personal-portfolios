# Shared root configuration for Next.js and the Python server.
# Copy this file to .env at the repository root and fill in SMTP credentials.
# Keep secrets server-only: never prefix them with NEXT_PUBLIC_.
CONTACT_SERVER_URL=http://127.0.0.1:8000
# In the Vercel FRONTEND project, use your deployed HTTPS backend URL instead:
# CONTACT_SERVER_URL=https://server-rho-virid.vercel.app
# Redeploy after changing environment variables. Set CONTACT_API_KEY identically
# in both Vercel projects; SMTP variables belong in the Python backend project.
# One shared random secret, at least 32 characters.
CONTACT_API_KEY=

# Neon Console -> Connect -> enable pooling -> copy the PostgreSQL connection URL.
# Add DATABASE_URL to the Python server project's Vercel environment too.
# Preserve sslmode=require (or stricter) and Neon's channel_binding option.
# Tables and indexes are created automatically on the first contact submission.
# Example: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Origin used in password reset emails. Set https://www.ekosamuel.com on Vercel.
AUTH_PUBLIC_URL=http://localhost:3000

# Authenticated email forwarding to info@ekosamuel.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=info@ekosamuel.com
